{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Static-asset Worker: no server code, Cloudflare just serves src/.
  // "name" must match the Cloudflare project name exactly. It deliberately
  // avoids the string "github-io": Chrome flags *-github-io.workers.dev as a
  // lookalike of github.io and shows a phishing interstitial.
  "name": "yashwanth-devavarapu",
  "compatibility_date": "2026-10-01",

  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },

  // Required by `npx wrangler preview`, the preview-build command. It may be
  // empty: assets and compatibility settings stay at the top level.
  "previews": {},

  "assets": {
    "directory": "./src",

    // html_handling is left at its default, "auto-trailing-slash". Setting it
    // to "none" matches assets exactly, which means "/" never resolves to
    // "/index.html" and the homepage 404s. The default costs one 307 on links
    // written with a .html extension, which is the cheaper trade.

    "not_found_handling": "404-page"
  }
}
